# 复制本文件为 .env 并填入实际值（.env 已被 gitignore，请勿提交到版本库）
# Windows PowerShell: copy .env.example .env
# Linux/macOS: cp .env.example .env

# Spring Boot 激活的 Profile（dev / prod）
SPRING_PROFILES_ACTIVE=dev

# ==================== 数据库配置 ====================
DB_URL=jdbc:mysql://localhost:3306/iot_device_db?useUnicode=true&characterEncoding=utf8&useSSL=false&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true
DB_USERNAME=root
DB_PASSWORD=your_db_password

# ==================== Druid 监控配置（开发环境可开启） ====================
DRUID_USERNAME=admin
DRUID_PASSWORD=admin

# ==================== Redis 配置 ====================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DATABASE=0

# ==================== JWT 配置 ====================
# 生产环境务必使用 openssl rand -base64 48 生成的随机字符串，至少 32 字符
JWT_SECRET=iot-platform-jwt-secret-key-must-be-at-least-32-chars
JWT_EXPIRATION=7200

# ==================== 邮箱（验证码注册与告警通知共用） ====================
MAIL_HOST=smtp.qq.com
MAIL_PORT=587
MAIL_USERNAME=your_account@qq.com
MAIL_AUTH_CODE=your_qq_mail_authorization_code
VERIFICATION_CODE_HMAC_SECRET=replace_with_a_long_random_secret

# ==================== 开放注册开关（true=允许自助注册，false=仅管理员建用户） ====================
AUTH_REGISTRATION_ENABLED=true
